# Render debe usar producción para cookies Secure + SameSite=None.
NODE_ENV=production

# Orígenes EXACTOS separados por coma. No uses * cuando credentials=true.
# Ejemplo web local + producción:
CORS_ORIGINS=http://localhost:8100,https://tu-frontend.example.com,capacitor://localhost,ionic://localhost

# Correo para recuperación de contraseña.
SMTP_SERVICE=gmail
SMTP_USER=correo@example.com
SMTP_PASS=APP_PASSWORD_NUEVA
MAIL_FROM=correo@example.com

# Opcional: convierte una cuenta existente a admin al arrancar.
# El cliente NUNCA puede elegir su propio role.
BOOTSTRAP_ADMIN_USERNAME=
